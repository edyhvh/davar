{
  "project": "Davar Mobile (React Native + Expo)",
  "purpose": "Minimalist, contemplative Bible study app focused on Hebrew Tanakh + Besorah texts with Qumran variants, offline-first architecture",
  "targetPlatforms": ["iOS 15+", "Android API 24+"],
  "designPhilosophy": "Reverent minimalism, academic precision, meditation-friendly UX",
  "designTokens": {
    "color": {
      "light": {
        "primary": "#7AA0D6",
        "primaryDark": "#6389BF",
        "secondary": "#B07A3C",
        "background": "#FDFDF9",
        "surface": "#FFFFFF",
        "textPrimary": "#1a1a1a",
        "textSecondary": "#6b6b6b",
        "border": "rgba(0,0,0,0.08)",
        "accentCopper": "#C68F55"
      },
      "dark": {
        "primary": "#92B5E8",
        "primaryDark": "#7B9ED1",
        "secondary": "#A06C35",
        "background": "#0F0E12",
        "surface": "#17161A",
        "textPrimary": "#ebdbb2",
        "textSecondary": "#a89984",
        "border": "rgba(255,255,255,0.1)",
        "accentCopper": "#C68F55"
      }
    },
    "typography": {
      "families": {
        "hebrewScripture": ["Cardo", "SBL Hebrew", "Ezra SIL"],
        "hebrewUI": ["Suez One"],
        "latinUI": ["Inter", "SF Pro"],
        "logo": "Suez One"
      },
      "sizesPt": {
        "h1": 28,
        "h2": 24,
        "h3": 20,
        "hebrewVerse": 36,
        "hebrewVerseLarge": 48,
        "body": 16,
        "bodySmall": 14,
        "caption": 12
      },
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "hebrewScripture": "1.8–2.0",
        "body": 1.5,
        "tight": 1.3
      }
    },
    "spacing": {
      "grid": "8pt",
      "valuesPx": {
        "1": 4,
        "2": 8,
        "3": 12,
        "4": 16,
        "5": 20,
        "6": 24,
        "8": 32,
        "10": 40,
        "12": 48,
        "16": 64
      },
      "safeAreas": {
        "top": {
          "ios": 44,
          "android": 24
        },
        "bottom": {
          "ios": 34,
          "android": 0
        }
      }
    },
    "borderRadius": {
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "full": 999
    },
    "shadows": {
      "iOS": {
        "raised": {
          "shadowColor": "#000",
          "shadowOffset": { "width": 0, "height": 6 },
          "shadowOpacity": 0.3,
          "shadowRadius": 12
        },
        "light": {
          "shadowColor": "#FFFFFF",
          "shadowOffset": { "width": 0, "height": -6 },
          "shadowOpacity": 0.7,
          "shadowRadius": 12
        },
        "pressed": {
          "shadowColor": "#BEBeC8",
          "shadowOffset": { "width": 3, "height": 3 },
          "shadowOpacity": 0.4,
          "shadowRadius": 6
        }
      },
      "android": {
        "elevation": {
          "1": 2,
          "2": 4,
          "3": 8,
          "4": 12
        }
      }
    }
  },
  "coreComponents": {
    "neumorphicButton": {
      "minTouchTarget": { "ios": "44x44", "android": "48x48" },
      "variants": ["primary", "secondary", "text"],
      "states": ["default", "pressed", "disabled"],
      "padding": { "vertical": 12, "horizontal": 24 },
      "borderRadius": "24 (pill) or 12",
      "iconGap": 8
    },
    "verseCard": {
      "layout": "vertical (Hebrew → Translation → Meta)",
      "hebrew": {
        "size": "36–48 pt Cardo",
        "lineHeight": "1.8–2.0",
        "alignment": "center",
        "direction": "rtl"
      },
      "translation": {
        "size": "16 pt Inter",
        "marginTop": 24,
        "color": "textSecondary",
        "alignment": "center"
      },
      "padding": 24,
      "background": "surface + neumorphic raised shadow",
      "gestureHint": "subtle up/down arrows or text"
    },
    "bottomTabBar": {
      "height": { "ios": 64, "android": 56 },
      "plusSafeBottom": true,
      "background": "surface + 1px top border",
      "iconSize": 24,
      "labelSize": 12,
      "activeColor": "primary",
      "inactiveColor": "textSecondary"
    },
    "textInput": {
      "minHeight": 48,
      "borderWidth": 1,
      "borderRadius": 12,
      "paddingHorizontal": 12,
      "focusBorderWidth": 2,
      "focusColor": "primary",
      "placeholderColor": "textSecondary",
      "placeholderSize": 14,
      "rtl": "textAlign: right for Hebrew"
    },
    "bottomSheet": {
      "handle": { "width": 32, "height": 4, "radius": "pill", "marginTop": 12 },
      "maxHeight": "90% screen",
      "borderRadius": { "topLeft": 24, "topRight": 24 },
      "padding": { "horizontal": 24, "top": 16 },
      "backdrop": "rgba(0,0,0,0.5)",
      "dismiss": "swipe down or tap backdrop"
    }
  },
  "navigation": {
    "type": "Bottom Tabs (fixed)",
    "tabs": [
      {
        "name": "Home/Library",
        "icon": "book-open",
        "label": "Library",
        "description": "Recent verses + quick access"
      },
      {
        "name": "Search",
        "icon": "search",
        "label": "Search",
        "description": "Word / verse / phrase lookup"
      },
      {
        "name": "Bookmarks",
        "icon": "bookmark",
        "label": "Bookmarks",
        "description": "Saved verses & notes"
      },
      {
        "name": "Settings",
        "icon": "settings",
        "label": "Settings",
        "description": "Preferences & offline status"
      }
    ]
  },
  "mainUserFlows": [
    {
      "id": "reading-journey",
      "title": "Reading Journey",
      "steps": [
        "Home/Library → tap Verse Card",
        "→ Verse Detail (immersive full-screen)"
      ]
    },
    {
      "id": "vertical-swipe-navigation",
      "title": "TikTok-style Verse Navigation",
      "gesture": "vertical swipe",
      "up": "previous verse",
      "down": "next verse",
      "animation": "300ms ease-out",
      "hints": "subtle chevron + ghost preview during swipe"
    },
    {
      "id": "word-study",
      "title": "Deep Word Analysis",
      "trigger": "tap Hebrew word in Verse Detail",
      "destination": "Word Analysis Bottom Sheet (slides up)",
      "content": [
        "Hebrew word (28pt Cardo RTL)",
        "Transliteration (14pt)",
        "Meanings (bullet list)",
        "Root section (copper highlight)",
        "Instances (scrollable verse refs → tap → navigate)"
      ]
    },
    {
      "id": "search-flow",
      "title": "Search & Discovery",
      "start": "Search tab → RTL-compatible input",
      "behavior": "live results while typing",
      "results": "compact Verse Cards with match highlight",
      "action": "tap → Verse Detail"
    }
  ],
  "keyScreens": [
    "Home / Library",
    "Verse Detail (immersive)",
    "Search",
    "Bookmarks",
    "Settings",
    "Word Analysis Bottom Sheet",
    "Book/Chapter Selector Modal"
  ],
  "implementationNotes": {
    "rtl": "I18nManager.forceRTL(true); + per-text writingDirection: 'rtl'",
    "offline": "Assume SQLite / encrypted local storage for texts & dictionary",
    "performance": [
      "Use FlatList for lists",
      "Memoize Hebrew text components",
      "Lazy-load sheets/modals"
    ],
    "gestures": "react-native-gesture-handler + reanimated",
    "animations": "subtle, 300–400ms, contemplative easing",
    "accessibility": "WCAG AA contrast, Dynamic Type support, screen reader labels",
    "safeAreas": "react-native-safe-area-context mandatory"
  },
  "cssVariables": {
    "colors": {
      "--neomorph-bg": "surface",
      "--neomorph-border": "border",
      "--accent": "secondary (or accentCopper for highlights)",
      "--text-secondary": "textSecondary",
      "--background": "background",
      "--surface": "surface",
      "--muted": "surface with 5% opacity overlay",
      "--text-primary": "textPrimary"
    },
    "shadows": {
      "--neomorph-shadow-dark": "6px 6px 16px rgba(0,0,0,0.15) [light mode] / rgba(0,0,0,0.4) [dark mode]",
      "--neomorph-shadow-light": "-6px -6px 16px rgba(255,255,255,0.7) [light mode] / rgba(255,255,255,0.05) [dark mode]",
      "--neomorph-inset-shadow-dark": "inset 6px 6px 12px rgba(0,0,0,0.1) [light mode] / rgba(0,0,0,0.3) [dark mode]",
      "--neomorph-inset-shadow-light": "inset -6px -6px 12px rgba(255,255,255,0.7) [light mode] / rgba(255,255,255,0.02) [dark mode]"
    },
    "spacing": {
      "--gutter": "16px",
      "--section-gap": "24px",
      "--component-gap": "8px"
    },
    "radius": {
      "--radius-sm": "8px",
      "--radius-md": "12px",
      "--radius-lg": "16px",
      "--radius-xl": "24px",
      "--radius-full": "999px"
    }
  },
  "lastUpdated": "2026-01"
}
