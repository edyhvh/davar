# Static JSON endpoints used by mobile services.
# Rule: explicit EXPO_PUBLIC_* values always win.
# If unset, code defaults to:
# - Development (__DEV__): http://127.0.0.1:3002/data
# - Production: https://davar.bible/data

# LOCAL DEVELOPMENT (simulator)
EXPO_PUBLIC_STATIC_DATA_BASE_URL=http://127.0.0.1:3002/data
EXPO_PUBLIC_STATIC_BUNDLES_BASE_URL=http://127.0.0.1:3002/data/bundles
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-real-supabase-publishable-key
# Optional legacy fallback if your project still uses anon keys.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-real-supabase-anon-key

# LOCAL DEVELOPMENT (physical device)
# Replace with your machine LAN IP and keep port/path the same.
# Do not use 127.0.0.1/localhost on a physical device (it points to the phone itself).
# EXPO_PUBLIC_STATIC_DATA_BASE_URL=http://192.168.1.50:3002/data
# EXPO_PUBLIC_STATIC_BUNDLES_BASE_URL=http://192.168.1.50:3002/data/bundles

# PRODUCTION
# Set these in EAS/CI environment variables for release builds.
# EXPO_PUBLIC_STATIC_DATA_BASE_URL=https://davar.bible/data
# EXPO_PUBLIC_STATIC_BUNDLES_BASE_URL=https://davar.bible/data/bundles
# EXPO_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=your-production-supabase-publishable-key
# Optional legacy fallback.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-supabase-anon-key

# Recommended workflow:
# 1) Keep this file committed as a template.
# 2) Put real local values in .env.local (gitignored).
# 3) Configure production values in EAS environment variables.

