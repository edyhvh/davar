{
  "name": "davar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start --port 8082",
    "start:clear": "expo start --port 8082 --clear",
    "ios": "expo run:ios",
    "ios:clean": "expo prebuild --clean --platform ios && expo run:ios --no-build-cache",
    "android": "expo run:android",
    "android:clean": "expo prebuild --clean --platform android && expo run:android",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "reset-project": "bun ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "^0.4.2",
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jost": "^0.4.2",
    "@expo-google-fonts/suez-one": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/elements": "^2.9.13",
    "@react-navigation/native": "^7.2.1",
    "@supabase/supabase-js": "^2.100.1",
    "expo": "~55.0.8",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-linear-gradient": "^55.0.9",
    "expo-linking": "~55.0.8",
    "expo-mail-composer": "^55.0.9",
    "expo-network": "^55.0.9",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.1",
    "react-native-circular-progress": "^1.4.1",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "typescript": "~5.8.3"
  },
  "private": true
}
