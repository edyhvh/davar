# Davar FastAPI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# API Security
DAVAR_API_KEY=your-secret-api-key-here

# CORS Settings
DAVAR_ALLOWED_ORIGINS=["http://localhost:3002","http://localhost:3003"]

# Rate Limiting
DAVAR_RATE_LIMIT=100/minute

# Environment
DAVAR_ENV=development

# FastAPI CLI
FASTAPI_PORT=2220

# Data Source Path (relative to backend directory)
DAVAR_DATA_PATH=../data

# Supabase Storage (for TS2009 private content)
DAVAR_SUPABASE_URL=your-supabase-url-here
DAVAR_SUPABASE_SERVICE_KEY=your-supabase-service-key-here
