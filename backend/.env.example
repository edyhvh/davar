# Davar FastAPI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# API Security
DAVAR_API_KEY=your-secret-api-key-here

# CORS Settings
DAVAR_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
DAVAR_RATE_LIMIT=100/minute

# Environment
DAVAR_ENV=development

# Data Source Path (relative to backend directory)
DAVAR_DATA_PATH=../data
